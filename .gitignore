
# =============================================================================
# .gitignore — Health Monitor ESP32
# =============================================================================

# =============================================================================
# ⛔ CREDENTIALS — JANGAN PERNAH COMMIT FILE INI
# =============================================================================
# Path sebelumnya salah (include/config/) — sekarang diperbaiki
firmware/include/config/credentials.h

# Pola umum secrets
*.secret
*.key
*.pem
*.env
.env
.env.*
server/.env
!*.env.example
secrets.h
secrets.json
config.local.*

# =============================================================================
# PlatformIO
# =============================================================================
.pio/
.pioenvs/
.piolibdeps/
firmware/.pio/
firmware/.vscode/.browse.c_cpp.db*
firmware/.vscode/c_cpp_properties.json
firmware/.vscode/launch.json
firmware/.vscode/ipch

# IDE
.vscode/
.idea/
*.code-workspace

# =============================================================================
# Python
# =============================================================================
__pycache__/
.ruff_cache/
*.pyc
*.pyo
*.pyd
*.so
server/__pycache__/
server/core/__pycache__/
server/apps/__pycache__/
.venv/
venv/
env/
*.egg-info/
dist/
build/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Type Checking
.mypy_cache/
.dmypy.json
dmypy.json

# Jupyter
.ipynb_checkpoints/

# =============================================================================
# OS
# =============================================================================
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# =============================================================================
# Graphify — knowledge graph (SENGAJA di-track, bukan diabaikan)
# =============================================================================
# graphify-out/ → JANGAN tambahkan ke .gitignore
# Folder ini berisi graph.json, graph.html, GRAPH_REPORT.md
# yang berguna untuk seluruh tim tanpa perlu rebuild
# Cache AST dikecualikan — besar (500+ file) dan bisa di-rebuild otomatis
graphify-out/cache/

# =============================================================================
# Node / npm (jika ada tooling)
# =============================================================================
node_modules/
npm-debug.log*

# =============================================================================
# Archive — tetap di-track
# =============================================================================
!archive/

# =============================================================================
# Temporary / Database Files
# =============================================================================
*.db
*.db-shm
*.db-wal
!server/tests/fixtures/*.db
new_feature/

# Logs
*.log
logs/

# Backups
**/backup/
