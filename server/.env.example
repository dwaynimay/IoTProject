# =============================================================================
# server/.env.example
# =============================================================================
# Salin file ini ke .env dan isi dengan nilai yang sesuai.
# JANGAN commit file .env ke repository — sudah ada di .gitignore.
#
# Cara setup:
#   cp server/.env.example server/.env
#   # Edit nilai di bawah sesuai environment Anda
# =============================================================================

# ── MQTT Broker ───────────────────────────────────────────────────────────────
# IP atau hostname broker MQTT Anda
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_KEEPALIVE=60
TOPIC_BASE=health_monitor

# Wajib untuk endpoint destruktif /api/purge dan DELETE /api/nodes/{id}/data.
# Kirim nilainya melalui header X-Admin-Token. Kosong = endpoint dinonaktifkan.
ADMIN_API_TOKEN=

# ── CS Algorithm ──────────────────────────────────────────────────────────────
# Pilihan: "hadamard"
# "hadamard"   → Hadamard + DCT + OMP (default, tidak butuh scikit-learn)
CS_ALGORITHM=hadamard

# ── Logging ───────────────────────────────────────────────────────────────────
# Pilihan: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ── Storage SQLite ────────────────────────────────────────────────────────────
DB_PATH=server/data/health_monitor.db
RETENTION_HOURS=24

# ── Timestamp Spread Tolerance ────────────────────────────────────────────────
# Toleransi spread antara cs_imu dan cs_ppg dalam milidetik
TS_SPREAD_TOLERANCE_MS=500
