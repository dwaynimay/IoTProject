# =============================================================================
# server/.env.example
# =============================================================================
# Salin file ini ke .env dan isi dengan nilai yang sesuai.
# JANGAN commit file .env ke repository — sudah ada di .gitignore.
#
# Cara setup:
#   cp server/.env.example server/.env
#   # Edit nilai di bawah sesuai environment Anda
# =============================================================================

# ── MQTT Broker ───────────────────────────────────────────────────────────────
# IP atau hostname broker MQTT Anda
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_KEEPALIVE=60
TOPIC_BASE=health_monitor

# ── CS Algorithm ──────────────────────────────────────────────────────────────
# Pilihan: "omp" atau "lasso"
# "omp"   → Hadamard-Gaussian + DCT + OMP (default, tidak butuh scikit-learn)
# "lasso" → Gaussian + DCT + LASSO (butuh: pip install scikit-learn)
CS_ALGORITHM=omp

# ── LASSO Parameter (hanya dipakai jika CS_ALGORITHM=lasso) ──────────────────
LASSO_ALPHA=0.001
LASSO_MAX_ITER=5000
LASSO_TOL=1e-5

# ── Logging ───────────────────────────────────────────────────────────────────
# Pilihan: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ── Storage SQLite ────────────────────────────────────────────────────────────
DB_PATH=health_monitor.db
RETENTION_HOURS=24

# ── Timestamp Spread Tolerance ────────────────────────────────────────────────
# Toleransi spread antara cs_imu dan cs_ppg dalam milidetik
TS_SPREAD_TOLERANCE_MS=500
